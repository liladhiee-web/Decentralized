# ==============================================================================
# Decentralized AI Cloud - Worker Agent Runtime Dockerfile
# Base environment for community GPU nodes with NVIDIA Container Toolkit
# ==============================================================================

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# Avoid interactive prompts during apt installs
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/usr/local/cuda/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

WORKDIR /app

# Install system dependencies and Python 3.11
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3-pip \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set python3.11 as default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Install core worker agent dependencies
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    python -m pip install --no-cache-dir \
    "pynvml>=11.5.0" \
    "docker>=7.1.0" \
    "httpx>=0.27.0" \
    "websockets>=12.0" \
    "pydantic>=2.8.0" \
    "rich>=13.7.0" \
    "typer>=0.12.0"

# Create non-root compute user
RUN groupadd -g 10002 workeruser && \
    useradd -u 10002 -g workeruser -s /bin/bash -m workeruser && \
    mkdir -p /app/workspace && \
    chown -R workeruser:workeruser /app

# Copy worker application files
COPY --chown=workeruser:workeruser worker /app/worker
COPY --chown=workeruser:workeruser shared /app/shared

USER workeruser

ENTRYPOINT ["python", "-m", "worker.agent"]

