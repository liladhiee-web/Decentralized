# ==============================================================================
# Decentralized AI Compute Cloud Platform - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_cryptographically_secure_random_64_char_string_for_production
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allowed CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# PostgreSQL Database Configuration
POSTGRES_USER=cloudai_user
POSTGRES_PASSWORD=cloudai_secure_password_replace_in_prod
POSTGRES_DB=cloudai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cloudai_user:cloudai_secure_password_replace_in_prod@postgres:5432/cloudai_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis Configuration (Queues, temporary state, rate limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=cloudai_redis_secure_pass
REDIS_DB=0
REDIS_URL=redis://:cloudai_redis_secure_pass@redis:6379/0

# MinIO / S3 Object Storage Configuration
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=cloudai_minio_admin
MINIO_ROOT_PASSWORD=cloudai_minio_secret_key_change_me
MINIO_SECURE=false
MINIO_BUCKET_MODELS=cloudai-models
MINIO_BUCKET_DATASETS=cloudai-datasets
MINIO_BUCKET_ARTIFACTS=cloudai-artifacts
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600

# Authentication and JWT Configuration
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_jwt_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Worker Protocol & Security
WORKER_AUTH_TOKEN_SALT=worker_token_hmac_salt_change_for_prod
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_TIMEOUT_SECONDS=60
WORKER_MAX_MISSED_HEARTBEATS=3

# Celery Task Queue
CELERY_BROKER_URL=redis://:cloudai_redis_secure_pass@redis:6379/1
CELERY_RESULT_BACKEND=redis://:cloudai_redis_secure_pass@redis:6379/2

# Rate Limiting & Compute Limits
RATE_LIMIT_PER_MINUTE=120
MAX_JOB_EXECUTION_TIME_SECONDS=86400
MAX_UPLOAD_SIZE_BYTES=107374182400

